<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RootRecovery" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#455A64</item>
        <item name="android:navigationBarColor">#FAFAFA</item>
        <item name="android:statusBarColor">#37474F</item>
    </style>

    <style name="Theme.RootRecovery.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>

    <style name="Theme.RootRecovery.Settings" parent="android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorPrimary">@android:color/white</item>
        <item name="android:colorAccent">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="SettingsToolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?android:attr/actionBarSize</item>
        <item name="android:background">@android:color/white</item>
        <item name="android:titleTextColor">?android:attr/textColorPrimary</item>
        <item name="android:titleTextAppearance">@style/SettingsToolbarTitle</item>
        <item name="android:titleMarginStart">16dp</item>
        <item name="android:titleMarginEnd">16dp</item>
    </style>

    <style name="SettingsToolbarTitle" parent="@android:style/TextAppearance.Large">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsSwitch">
        <item name="android:background">@null</item>
        <item name="android:thumb">@drawable/settings_switch_thumb</item>
        <item name="android:track">@drawable/settings_switch_track</item>
        <item name="android:showText">false</item>
    </style>

    <style name="SettingsGroupContainer">
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_settings_group</item>
        <item name="android:outlineProvider">background</item>
        <item name="android:paddingTop">@dimen/settings_group_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/settings_group_padding_vertical</item>
    </style>

    <style name="SettingsListItemContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">?android:attr/listPreferredItemHeight</item>
        <item name="android:paddingStart">?android:attr/listPreferredItemPaddingLeft</item>
        <item name="android:paddingEnd">?android:attr/listPreferredItemPaddingRight</item>
        <item name="android:paddingTop">@dimen/settings_row_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/settings_row_padding_vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SettingsListItemTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:textColor">@color/settings_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsListItemDescription">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/settings_row_body_margin_top</item>
        <item name="android:textAppearance">?android:attr/textAppearanceSmall</item>
        <item name="android:textColor">@color/settings_text_secondary</item>
    </style>
</resources>
